# Copy this file to .env and fill in the real values (.env is ignored by Git).
# If any variable is missing, the pipeline falls back to resources/jira_issues_raw.json.

# Azure Blob Storage (read-only data source)
ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net
CONTAINER_NAME=<container-name>
BLOB_NAME=<blob-name>.json

# Service Principal
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=<client-secret>
